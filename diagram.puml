@startuml
title Sơ đồ Use Case tổng quát - Hệ thống quản trị TeeStudio

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #0F172A
  FontSize 12
}
skinparam rectangle {
  BorderColor #CBD5E1
  BackgroundColor #FFFFFF
}
skinparam package {
  BorderColor #38BDF8
  BackgroundColor #F0F9FF
  FontColor #075985
  FontStyle bold
}

actor "Quản trị viên\nADMIN" as Admin
actor "Nhân sự sản xuất\nPRODUCTION" as Production
actor "Thủ kho\nWAREHOUSE" as Warehouse
actor "Khách hàng" as Customer <<external>>
actor "Cổng thanh toán\nVNPAY / MOMO" as Gateway <<external>>

rectangle "TeeStudio Admin" {
  package "Tổng quan" {
    usecase "Xem dashboard\nvận hành" as UC_Dashboard
    usecase "Theo dõi cảnh báo\nthiết kế / tồn kho" as UC_AlertOverview
  }

  package "Thống kê" {
    usecase "Xem báo cáo\nthống kê" as UC_Stats
    usecase "Xuất báo cáo\nExcel" as UC_ReportExport
  }

  package "Đơn hàng" {
    usecase "Tra cứu,\nlọc đơn hàng" as UC_OrderList
    usecase "Tạo đơn hàng" as UC_OrderCreate
    usecase "Xem chi tiết\nđơn hàng" as UC_OrderDetail
    usecase "Cập nhật\ntrạng thái đơn" as UC_OrderStatus
    usecase "Hủy đơn /\nsửa địa chỉ" as UC_OrderEdit
    usecase "Tạo lại QR\nthanh toán" as UC_RecreatePayment
  }

  package "Sản phẩm / Phôi áo" {
    usecase "Quản lý\nphôi áo" as UC_Product
    usecase "Quản lý\nbiến thể SKU" as UC_Variant
    usecase "Theo dõi cảnh báo\ntồn thấp" as UC_ProductAlert
  }

  package "Kho hàng" {
    usecase "Theo dõi\ntồn kho" as UC_Inventory
    usecase "Ghi giao dịch\nnhập/xuất/điều chỉnh" as UC_StockTransaction
    usecase "Nhập kho\nnhiều dòng" as UC_StockImport
    usecase "Xem lịch sử\nkho" as UC_StockHistory
  }

  package "Thiết kế & In ấn" {
    usecase "Tra cứu\nthiết kế" as UC_DesignList
    usecase "Duyệt / yêu cầu\nchỉnh sửa thiết kế" as UC_DesignReview
    usecase "Sửa thiết kế\nbằng Editor" as UC_DesignEdit
    usecase "Quản lý\nđơn cần in" as UC_PrintOrder
    usecase "Cập nhật\ntiến độ in" as UC_PrintStatus
    usecase "Quản lý\nsticker tài nguyên" as UC_DesignAsset
  }

  package "Thanh toán" {
    usecase "Tra cứu\ngiao dịch" as UC_PaymentList
    usecase "Xem chi tiết\n& lịch sử IPN" as UC_PaymentDetail
    usecase "Xác nhận\nthu COD" as UC_ConfirmCOD
    usecase "Ghi chú\nkế toán" as UC_PaymentNote
    usecase "Xuất báo cáo\nthanh toán" as UC_PaymentExport
  }

  package "Khuyến mãi & Báo giá" {
    usecase "Quản lý mã\nkhuyến mãi" as UC_Promotion
    usecase "Thiết lập\ngiá số lượng lớn" as UC_BulkPrice
    usecase "Cấu hình\nphụ phí in" as UC_Surcharge
    usecase "Cấu hình\ncông thức báo giá" as UC_PricingFormula
  }

  package "Tài khoản" {
    usecase "Quản lý tài khoản\nkhách hàng" as UC_CustomerAccount
    usecase "Khóa / khôi phục\ntài khoản" as UC_AccountStatus
    usecase "Quản lý nhân sự\nnội bộ" as UC_StaffAccount
    usecase "Phân quyền\nvai trò" as UC_Role
  }
}

' ADMIN có toàn quyền trên 9 menu
Admin --> UC_Dashboard
Admin --> UC_AlertOverview
Admin --> UC_Stats
Admin --> UC_ReportExport
Admin --> UC_OrderList
Admin --> UC_OrderCreate
Admin --> UC_OrderDetail
Admin --> UC_OrderStatus
Admin --> UC_OrderEdit
Admin --> UC_RecreatePayment
Admin --> UC_Product
Admin --> UC_Variant
Admin --> UC_ProductAlert
Admin --> UC_Inventory
Admin --> UC_StockTransaction
Admin --> UC_StockImport
Admin --> UC_StockHistory
Admin --> UC_DesignList
Admin --> UC_DesignReview
Admin --> UC_DesignEdit
Admin --> UC_PrintOrder
Admin --> UC_PrintStatus
Admin --> UC_DesignAsset
Admin --> UC_PaymentList
Admin --> UC_PaymentDetail
Admin --> UC_ConfirmCOD
Admin --> UC_PaymentNote
Admin --> UC_PaymentExport
Admin --> UC_Promotion
Admin --> UC_BulkPrice
Admin --> UC_Surcharge
Admin --> UC_PricingFormula
Admin --> UC_CustomerAccount
Admin --> UC_AccountStatus
Admin --> UC_StaffAccount
Admin --> UC_Role

' PRODUCTION theo AdminSidebar: Đơn hàng, Thiết kế & In ấn
Production --> UC_OrderList
Production --> UC_OrderDetail
Production --> UC_OrderStatus
Production --> UC_DesignList
Production --> UC_DesignReview
Production --> UC_DesignEdit
Production --> UC_PrintOrder
Production --> UC_PrintStatus
Production --> UC_DesignAsset

' WAREHOUSE theo AdminSidebar: Sản phẩm / Phôi áo, Kho hàng
Warehouse --> UC_Product
Warehouse --> UC_Variant
Warehouse --> UC_ProductAlert
Warehouse --> UC_Inventory
Warehouse --> UC_StockTransaction
Warehouse --> UC_StockImport
Warehouse --> UC_StockHistory

' Quan hệ include/extend nghiệp vụ chính
UC_OrderCreate ..> UC_Product : <<include>>
UC_OrderCreate ..> UC_Promotion : <<include>>
UC_OrderStatus ..> UC_PrintStatus : <<include>>
UC_OrderStatus ..> UC_ConfirmCOD : <<extend>>
UC_OrderEdit ..> UC_StockTransaction : <<include>>
UC_DesignReview ..> Customer : gửi yêu cầu sửa
UC_RecreatePayment ..> Gateway : tạo QR / link
UC_PaymentDetail ..> Gateway : nhận IPN
UC_StockImport ..> UC_StockTransaction : <<include>>
UC_PaymentExport ..> UC_PaymentList : <<include>>
UC_ReportExport ..> UC_Stats : <<include>>
UC_Role ..> UC_StaffAccount : <<include>>

legend right
  ADMIN: truy cập toàn bộ 9 menu
  PRODUCTION: Đơn hàng, Thiết kế & In ấn
  WAREHOUSE: Sản phẩm / Phôi áo, Kho hàng
endlegend

@enduml
