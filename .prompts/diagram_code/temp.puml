@startuml
title Sơ đồ hoạt động - Quy trình Áp dụng Khuyến mãi và Báo giá

skinparam shadowing false
skinparam defaultFontName Arial
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam ActivityBorderColor #334155
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityFontColor #0F172A
skinparam DiamondBorderColor #334155
skinparam DiamondBackgroundColor #EEF2FF
skinparam NoteBorderColor #94A3B8
skinparam NoteBackgroundColor #FFF7ED
skinparam SwimlaneBorderColor #CBD5E1
skinparam SwimlaneTitleBackgroundColor #E0F2FE

legend right
  Chức năng trong mã nguồn:
  - Customer: POST /api/promotions/validate
  - Service dùng chung: apDungMaGiamGia()
  - Tạo đơn thật: customer.order.service.js
  - Báo giá sỉ: BulkPricing
  - Cấu hình báo giá: PricingConfiguration

  Trường Promotion đang có:
  code, discountType, discountValue,
  minOrderAmount, startDate, endDate,
  usageLimit, usedCount,
  isNewCustomerOnly, status.

  Lưu ý:
  Mã nguồn hiện tại chưa có trường cấu hình
  danh mục áo áp dụng riêng cho Promotion.
endlegend

|Khách hàng|
start
:Xem giỏ hàng tại trang thanh toán;
:Nhập mã khuyến mãi;
:Bấm nút Áp dụng;

|Giao diện Checkout|
:Chuẩn hóa mã nhập từ khách hàng;
:Tính tạm tính giỏ hàng hiện tại\nsubtotal = tổng price x quantity;
:Gửi yêu cầu xem trước mã khuyến mãi;

|Backend Khuyến mãi|
:POST /api/promotions/validate;
:Xác thực khách hàng có vai trò CUSTOMER;
:Chuẩn hóa code bằng trim và uppercase;

if (Mã khuyến mãi có tồn tại?) then (Có)
  :Truy vấn Promotion theo code;
else (Không)
  :Trả lỗi: Mã khuyến mãi không tồn tại;
  |Giao diện Checkout|
  :Xóa mã đã áp dụng nếu có;
  :Hiển thị thông báo từ chối;
  stop
endif

|Backend Khuyến mãi|
:Gọi service dùng chung\napDungMaGiamGia();

if (Mã đang ACTIVE?) then (Có)
else (Không)
  :Từ chối do mã không còn hiệu lực;
  |Giao diện Checkout|
  :Hiển thị lý do từ chối;
  stop
endif

|Backend Khuyến mãi|
if (Mã còn trong thời gian áp dụng?) then (Có)
else (Không)
  :Từ chối do mã chưa đến ngày áp dụng\nhoặc đã hết hạn;
  |Giao diện Checkout|
  :Hiển thị lý do từ chối;
  stop
endif

|Backend Khuyến mãi|
if (Còn lượt sử dụng?) then (Có)
else (Không)
  :Từ chối do mã đã hết lượt sử dụng;
  |Giao diện Checkout|
  :Hiển thị lý do từ chối;
  stop
endif

|Backend Khuyến mãi|
if (Nếu chỉ dành cho khách mới,\nkhách hàng chưa từng đặt đơn?) then (Đạt)
else (Không đạt)
  :Từ chối do mã chỉ dành cho khách hàng mới;
  |Giao diện Checkout|
  :Hiển thị lý do từ chối;
  stop
endif

|Backend Khuyến mãi|
if (Đơn hàng đạt giá trị tối thiểu?) then (Đạt)
else (Không đạt)
  :Từ chối do chưa đạt minOrderAmount;
  |Giao diện Checkout|
  :Hiển thị lý do từ chối;
  stop
endif

|Backend Khuyến mãi|
if (Khách hàng chưa từng dùng mã này?) then (Đạt)
else (Không đạt)
  :Từ chối do mỗi khách chỉ được dùng\nmỗi mã một lần;
  |Giao diện Checkout|
  :Hiển thị lý do từ chối;
  stop
endif

|Backend Khuyến mãi|
:Kiểm tra phạm vi danh mục áo áp dụng\nnếu hệ thống có cấu hình danh mục;
note right
  Trong mã nguồn hiện tại, bảng Promotion và service
  apDungMaGiamGia chưa có trường hoặc truy vấn danh mục áo.
  Vì vậy điều kiện danh mục được thể hiện như yêu cầu nghiệp vụ,
  chưa phải một ràng buộc đang được thực thi trong module promotions.
end note

if (Điều kiện khuyến mãi thỏa mãn?) then (Thỏa mãn)
  :Tính số tiền giảm theo discountType;
  if (Loại giảm là PERCENT?) then (Có)
    :discountAmount = orderBaseAmount\nx discountValue / 100;
  else (Không)
    if (Loại giảm là FIXED?) then (Có)
      :discountAmount = discountValue;
    else (FREE_SHIPPING)
      :discountAmount = 0;
      :mienPhiVanChuyen = true;
    endif
  endif
  :Giới hạn discountAmount\nkhông vượt quá orderBaseAmount;
  :Làm tròn discountAmount\nđến 2 chữ số thập phân;
else (Từ chối)
  :Trả lỗi không áp dụng được mã;
  |Giao diện Checkout|
  :Hiển thị lý do từ chối;
  stop
endif

|Giao diện Checkout|
:Nhận kết quả xem trước gồm\npromotionId, code, discountType,\ndiscountAmount, mienPhiVanChuyen;
:Cập nhật tổng tiền hiển thị;
:Nếu mienPhiVanChuyen = true\nthì phí vận chuyển hiển thị bằng 0;
:Tổng hiển thị = subtotal + phí vận chuyển\n- discountAmount;

|Khách hàng|
:Xác nhận đặt hàng;

|Backend Đơn hàng|
:Nhận yêu cầu tạo đơn có promotionId;
:Không tin số tiền từ client;\nbackend tính lại toàn bộ giá trị đơn;
:Kiểm tra khách hàng, địa chỉ,\nbiến thể, tồn kho và thiết kế;

|Backend Đơn hàng|
:Tính đơn giá từng dòng theo báo giá sỉ;
note right
  Công thức BulkPricing trong code:
  chọn mức có minQty lớn nhất nhưng <= quantity.
  unitPrice = basePrice x (1 - discountPercent / 100).
  Nếu không có mức phù hợp thì dùng basePrice.
end note
:Tính subtotal = tổng unitPrice x quantity;
:Tính tổng phí thiết kế nếu có;
:Tính orderBaseAmount = subtotal + tổng phí thiết kế;

if (Có promotionId?) then (Có)
  |Backend Khuyến mãi|
  :Truy vấn lại Promotion theo id;
  :Gọi lại apDungMaGiamGia()\nvới orderBaseAmount thật từ DB;

  if (Khuyến mãi vẫn hợp lệ tại thời điểm tạo đơn?) then (Hợp lệ)
    :Trả discountAmount\nvà cờ miễn phí vận chuyển;
  else (Không hợp lệ)
    :Từ chối tạo đơn và trả lỗi;
    stop
  endif

  |Backend Đơn hàng|
  :Nếu miễn phí vận chuyển\nthì shippingFee = 0;
else (Không)
  :Không áp dụng giảm giá;
endif

|Backend Đơn hàng|
:Tính tổng cuối cùng;
:totalAmount = subtotal + designFee\n+ shippingFee - discountAmount;
:Bảo đảm totalAmount không âm;
:Tính thông tin thanh toán\nCOD, thanh toán đầy đủ hoặc đặt cọc;

|Cơ sở dữ liệu|
:Lưu CustomerOrder với\npromotionId, discountAmount,\nshippingFee, totalAmount;
:Lưu OrderItem, Payment\nvà các dữ liệu liên quan;

if (Có khuyến mãi được áp dụng thật?) then (Có)
  :Ghi PromotionUsage;
  :Tăng Promotion.usedCount thêm 1;
else (Không)
  :Không ghi PromotionUsage;
endif

|Backend Đơn hàng|
:Trả kết quả tạo đơn\nvà thông tin thanh toán;

|Giao diện Checkout|
:Hiển thị kết quả cuối cùng\ncho khách hàng;

stop
@enduml
