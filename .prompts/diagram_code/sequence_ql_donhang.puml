@startuml
title Sequence Diagram - Xử lý xác nhận thanh toán VNPAY/MOMO IPN

skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  ActorBorderColor #0F172A
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #64748B
  ParticipantBackgroundColor #F8FAFC
  ParticipantFontColor #0F172A
  BoxBorderColor #CBD5E1
  BoxBackgroundColor #F8FAFC
}

actor "Cổng thanh toán\nVNPAY/MOMO" as Gateway

box "Backend Public API" #DCFCE7
  participant "payment.routes\npublicRouter" as Routes
  participant "admin.payment.controller\nxuLyIpn()" as Controller
  participant "admin.payment.service" as PaymentService
  participant "vnpay.service /\nmomo.service" as VerifyService
  participant "order-payment-progress.service\nsyncOrderPaymentStatus()" as OrderPaymentSync
end box

database "MySQL Database" as DB

== Gateway gửi IPN ==
alt VNPAY IPN
  Gateway -> Routes: GET /api/payments/vnpay/ipn\n(query: vnp_TxnRef, vnp_Amount,\nvnp_ResponseCode, vnp_TransactionStatus,\nvnp_SecureHash, ...)
else MOMO IPN
  Gateway -> Routes: POST /api/payments/momo/ipn\n(JSON body: orderId, amount,\nresultCode, transId, signature, ...)
end

Routes -> Controller: xuLyIpn(req, res, next)
Controller -> Controller: gateway = req.params.gateway.toLowerCase()
Controller -> Controller: getOnlineGatewayHandler(gateway)

alt Gateway không được hỗ trợ
  break Dừng xử lý
    Controller --> Routes: Throw 404\n"Cổng thanh toán không được hỗ trợ"
    Routes --> Gateway: HTTP 404
  end
else Gateway hợp lệ
  alt gateway = "vnpay"
    Controller -> PaymentService: xuLyIpnVnpay(req.query)
  else gateway = "momo"
    Controller -> PaymentService: xuLyIpnMomo(req.body)
  end
end

== Xác thực chữ ký IPN ==
activate PaymentService

alt VNPAY
  PaymentService -> VerifyService: xacThucPhanHoiVnpay(query)
  VerifyService -> VerifyService: Loại bỏ vnp_SecureHash,\nvnp_SecureHashType
  VerifyService -> VerifyService: buildSignData(params)\ncreateSecureHash(hashSecret)
  VerifyService -> VerifyService: Kiểm tra vnp_TmnCode\nvà so sánh secure hash
  VerifyService --> PaymentService: true / false

  alt Chữ ký VNPAY không hợp lệ
    break Dừng xử lý IPN VNPAY
      PaymentService --> Controller: { RspCode:"97",\nMessage:"Invalid Checksum" }
      Controller --> Routes: res.json(result)
      Routes --> Gateway: HTTP 200\n{ RspCode:"97", Message:"Invalid Checksum" }
    end
  else Chữ ký VNPAY hợp lệ
    PaymentService -> PaymentService: dongBoTrangThaiVnpay(query)
  end
else MOMO
  PaymentService -> VerifyService: xacThucPhanHoiMomo(payload)
  VerifyService -> VerifyService: Kiểm tra partnerCode
  VerifyService -> VerifyService: taoChuKyKetQuaThanhToan(payload)\ncreateMomoSignature(accessKey, secretKey)
  VerifyService -> VerifyService: So sánh signature
  VerifyService --> PaymentService: true / false

  alt Chữ ký MOMO không hợp lệ
    break Dừng xử lý IPN MOMO
      PaymentService --> Controller: Throw 400\n"Chữ ký IPN MoMo không hợp lệ"
      Controller --> Routes: next(error)
      Routes --> Gateway: HTTP 400
    end
  else Chữ ký MOMO hợp lệ
    PaymentService -> PaymentService: dongBoTrangThaiMomo(payload, "ipn")
  end
end

== Đồng bộ giao dịch thanh toán ==
PaymentService -> DB: getConnection()
PaymentService -> DB: BEGIN TRANSACTION

alt VNPAY
  PaymentService -> PaymentService: transactionRef = query.vnp_TxnRef\namount = vnp_Amount / 100
  PaymentService -> DB: SELECT Payment JOIN CustomerOrder\nWHERE transactionId = transactionRef\nAND paymentMethod = 'VNPAY'\nLIMIT 1 FOR UPDATE
else MOMO
  PaymentService -> PaymentService: transactionRef = payload.orderId\namount = payload.amount
  PaymentService -> DB: SELECT Payment JOIN CustomerOrder\nWHERE transactionId = transactionRef\nAND paymentMethod = 'MOMO'\nLIMIT 1 FOR UPDATE
end

DB --> PaymentService: payment + orderCode + orderStatus

alt Không tìm thấy Payment
  PaymentService -> DB: ROLLBACK
  alt VNPAY
    PaymentService --> Controller: { RspCode:"01",\nMessage:"Order not found" }
    Controller --> Routes: res.json(result)
    Routes --> Gateway: HTTP 200\n{ RspCode:"01", Message:"Order not found" }
  else MOMO
    PaymentService --> Controller: Throw 400\n"Không tìm thấy giao dịch MoMo"
    Controller --> Routes: next(error)
    Routes --> Gateway: HTTP 400
  end
else Số tiền không khớp
  PaymentService -> DB: ROLLBACK
  alt VNPAY
    PaymentService --> Controller: { RspCode:"04",\nMessage:"Invalid Amount" }
    Controller --> Routes: res.json(result)
    Routes --> Gateway: HTTP 200\n{ RspCode:"04", Message:"Invalid Amount" }
  else MOMO
    PaymentService --> Controller: Throw 400\n"Số tiền giao dịch MoMo không khớp"
    Controller --> Routes: next(error)
    Routes --> Gateway: HTTP 400
  end
else Payment đã COMPLETED
  PaymentService -> DB: ROLLBACK
  alt VNPAY
    PaymentService --> Controller: { RspCode:"02",\nMessage:"Order already confirmed" }
    Controller --> Routes: res.json(result)
    Routes --> Gateway: HTTP 200\n{ RspCode:"02", Message:"Order already confirmed" }
  else MOMO
    PaymentService --> Controller: accepted=true
    Controller --> Routes: res.status(204).send()
    Routes --> Gateway: HTTP 204 No Content
  end
else Payment không còn khả dụng\n(status != PENDING hoặc đơn CANCELLED)
  PaymentService -> DB: ROLLBACK
  alt VNPAY
    PaymentService --> Controller: { RspCode:"02",\nMessage:"Payment is no longer available" }
    Controller --> Routes: res.json(result)
    Routes --> Gateway: HTTP 200\n{ RspCode:"02", Message:"Payment is no longer available" }
  else MOMO
    PaymentService --> Controller: Throw 400\n"Giao dịch MoMo không còn khả dụng"
    Controller --> Routes: next(error)
    Routes --> Gateway: HTTP 400
  end
else Payment hợp lệ để cập nhật
  alt Gateway báo thanh toán thành công
    PaymentService -> PaymentService: nextStatus = 'COMPLETED'\npaidAt = now hoặc responseTime(MOMO)
  else Gateway báo đang xử lý\n(VNPAY code 07/99 hoặc MoMo pending)
    PaymentService -> PaymentService: nextStatus = 'PENDING'\npaidAt = null
  else Gateway báo thất bại
    PaymentService -> PaymentService: nextStatus = 'FAILED'\npaidAt = null
  end

  PaymentService -> PaymentService: mergeGatewayResponse(current,\nIPN payload + source='ipn' nếu MOMO)
  PaymentService -> DB: UPDATE Payment\nSET status = nextStatus,\npaidAt = paidAt,\ngatewayResponse = mergedPayload\nWHERE id = payment.id\nAND status = 'PENDING'
  DB --> PaymentService: affectedRows

  alt affectedRows = 0
    PaymentService -> DB: ROLLBACK
    alt VNPAY
      PaymentService --> Controller: { RspCode:"02",\nMessage:"Order already confirmed" }
      Controller --> Routes: res.json(result)
      Routes --> Gateway: HTTP 200
    else MOMO
      PaymentService --> Controller: accepted=true
      Controller --> Routes: res.status(204).send()
      Routes --> Gateway: HTTP 204 No Content
    end
  else Cập nhật Payment thành công
    PaymentService -> OrderPaymentSync: syncOrderPaymentStatus(conn, orderId)
    OrderPaymentSync -> DB: UPDATE CustomerOrder\nSET paymentStatus = CASE\n  SUM(Payment.amount WHERE status='COMPLETED') >= totalAmount -> 'PAID'\n  SUM(...) > 0 -> 'PARTIALLY_PAID'\n  ELSE 'PENDING'\nEND\nWHERE id = orderId
    DB --> OrderPaymentSync: OK
    OrderPaymentSync --> PaymentService: OK

    PaymentService -> DB: COMMIT

    alt VNPAY
      PaymentService --> Controller: { RspCode:"00",\nMessage:"Confirm Success" }
      Controller --> Routes: res.json(result)
      Routes --> Gateway: HTTP 200\n{ RspCode:"00", Message:"Confirm Success" }
    else MOMO
      PaymentService --> Controller: accepted=true
      Controller --> Routes: res.status(204).send()
      Routes --> Gateway: HTTP 204 No Content
    end
  end
end

deactivate PaymentService

== Kết quả sau IPN ==
note over DB
  Payment.status được cập nhật thành:
  - COMPLETED nếu gateway xác nhận thành công
  - PENDING nếu gateway còn đang xử lý
  - FAILED nếu gateway báo thất bại

  CustomerOrder.paymentStatus được đồng bộ:
  - PAID nếu tổng tiền COMPLETED >= totalAmount
  - PARTIALLY_PAID nếu đã có một phần tiền COMPLETED
  - PENDING nếu chưa có khoản nào COMPLETED
end note

@enduml
